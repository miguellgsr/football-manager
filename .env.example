# Escolha UM provedor de IA.
# AI_PROVIDER=gemini  -> usa a API gratuita do Google (GEMINI_API_KEY)
# AI_PROVIDER=anthropic -> usa Claude (ANTHROPIC_API_KEY, pago por uso)
# Se não definir, usa Claude quando houver ANTHROPIC_API_KEY, senão Gemini.
AI_PROVIDER=gemini

# Gemini (gratuito, sem cartão): chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Claude (opcional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Recomendado: código de acesso. Se definido, as rotas de IA só respondem
# a quem informar esse código na aba Extras & Clube.
ACCESS_CODE=
