# Obrigatória: chave da API da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Opcional: modelo usado (padrão: claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-sonnet-5-5

# Recomendado: código de acesso. Se definido, as rotas de IA só respondem
# a quem informar esse código no site (evita que estranhos gastem sua chave).
ACCESS_CODE=
